---
// frontend/src/pages/index.astro
import '../styles/globals.css';
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>AAA TEAM 하이브리드 게이트웨이</title>
		<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" rel="stylesheet" />
		<style>
			/* Astro에 Tailwind가 없는 문제를 보완하기 위한 컴포넌트별 CSS 스타일링 */
			.container {
				max-width: 640px;
				margin: auto;
				text-align: center;
				padding: 2rem;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.badge {
				display: inline-block;
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--muted);
				font-weight: 700;
				background-color: var(--card);
				padding: 0.4rem 1rem;
				border-radius: 9999px;
				border: 1px solid var(--card-border);
				margin: 0 auto;
			}
			.title {
				font-size: 2.5rem;
				font-weight: 800;
				line-height: 1.2;
				letter-spacing: -0.03em;
				color: var(--foreground);
			}
			.title span {
				color: var(--warning);
			}
			.description {
				color: var(--muted);
				font-size: 1rem;
				line-height: 1.6;
				max-width: 480px;
				margin: 0 auto;
			}
			.btn-group {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				justify-content: center;
				margin-top: 1.5rem;
			}
			@media (min-width: 640px) {
				.btn-group {
					flex-direction: row;
				}
				.title {
					font-size: 3.5rem;
				}
			}
			.btn-primary {
				padding: 0.75rem 1.5rem;
				border-radius: var(--radius);
				background-color: var(--warning);
				color: hsl(var(--hue-base), 15%, 8%);
				font-weight: 700;
				font-size: 0.875rem;
				text-decoration: none;
				transition: var(--transition);
				box-shadow: 0 4px 14px 0 rgba(250, 204, 21, 0.2);
			}
			.btn-primary:hover {
				background-color: hsl(48, 96%, 60%);
				transform: translateY(-2px);
			}
			.btn-secondary {
				padding: 0.75rem 1.5rem;
				border-radius: var(--radius);
				background-color: var(--card);
				color: var(--foreground);
				font-weight: 700;
				font-size: 0.875rem;
				text-decoration: none;
				border: 1px solid var(--card-border);
				transition: var(--transition);
			}
			.btn-secondary:hover {
				background-color: var(--card-hover);
				transform: translateY(-2px);
			}
			.footer-text {
				color: var(--muted-foreground);
				font-size: 0.75rem;
				text-align: center;
				margin-top: auto;
				padding-bottom: 2rem;
			}
		</style>
	</head>
	<body class="bg-neutral-950 text-neutral-100 min-h-screen flex flex-col justify-between p-8 font-sans">
		
		<main class="container">
			<div style="display: flex; justify-content: center;">
				<span class="badge">
					Astro SSG Gateway
				</span>
			</div>
			
			<h1 class="title">
				AAA TEAM <span>공식 연구 아카이브</span>
			</h1>
			
			<p class="description">
				Obsidian 지식 창고로부터 정밀 변환 및 보안 필터링을 거쳐 배포되는 초고속 정적 리서치 아카이브입니다. 실시간 파이프라인 제어반은 동적 대시보드로 즉시 라우팅됩니다.
			</p>
			
			<div class="btn-group">
				<a 
					href="/dashboard" 
					class="btn-primary"
				>
					실시간 대시보드 진입 (/dashboard)
				</a>
				<a 
					href="https://github.com/git2583/aaa-git2583-vault" 
					target="_blank"
					class="btn-secondary"
				>
					Private Obsidian Vault 
				</a>
			</div>
		</main>

		<footer class="footer-text">
			<p>© 2026 AAA TEAM by git2583 · Powered by Antigravity 2.0 Hybrid Architecture</p>
		</footer>

	</body>
</html>
